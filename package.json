{
  "name": "examtrace",
  "productName": "ExamTrace",
  "version": "0.1.0",
  "description": "ExamTrace - Smart Desktop Examination & Activity Monitoring System",
  "author": "Supreet",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "vite": "vite",
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "server": "node server/index.js",
    "server:lan": "EXAMTRACE_LAN=1 node server/index.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.supreet.examtrace",
    "productName": "ExamTrace",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg",
      "extendInfo": {
        "NSCameraUsageDescription": "ExamTrace can show a live camera preview during an examination when the examiner enables camera monitoring. No video is recorded or uploaded."
      }
    }
  }
}
